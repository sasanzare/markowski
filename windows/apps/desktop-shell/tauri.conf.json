{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markowski",
  "version": "0.1.0",
  "identifier": "com.markowski.windows",
  "build": {
    "beforeDevCommand": "cd desktop-ui && trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd desktop-ui && trunk build --release",
    "frontendDist": "../desktop-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Markowski",
        "width": 960,
        "height": 640,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
